{
  "info": {
    "name": "Tarea U2 · Daniel Palacios · Alquiler de bicicletas",
    "description": "Prueba integral del caso 11: autenticación, catálogo MongoDB, alquiler PostgreSQL, consulta unida, reportes y limpieza.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "Daniel123!" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "bikeId", "value": "" },
    { "key": "rentalId", "value": "" },
    { "key": "reportId1", "value": "" },
    { "key": "reportId2", "value": "" },
    { "key": "serialNumber", "value": "" }
  ],
  "item": [
    {
      "name": "01 · Registrar usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Daniel Palacios\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      },
      "event": [{ "listen": "prerequest", "script": { "exec": ["const run = Date.now().toString();", "pm.collectionVariables.set('email', `daniel.palacios.${run}@example.com`);", "pm.collectionVariables.set('serialNumber', `BIC-${run.slice(-4)}`);", "pm.collectionVariables.unset('token');", "pm.collectionVariables.unset('bikeId');", "pm.collectionVariables.unset('rentalId');", "pm.collectionVariables.unset('reportId1');", "pm.collectionVariables.unset('reportId2');"] } }, { "listen": "test", "script": { "exec": ["pm.test('Registro responde 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.test('Devuelve usuario y token', () => { pm.expect(body).to.have.property('id'); pm.expect(body).to.have.property('token'); });", "pm.test('El correo creado coincide', () => pm.expect(body.email).to.eql(pm.collectionVariables.get('email')));", "pm.collectionVariables.set('token', body.token);", "pm.collectionVariables.set('userId', body.id);"] } }]
    },
    {
      "name": "02 · Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login responde 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('El token del login es texto', () => pm.expect(body.token).to.be.a('string').and.not.empty);", "pm.test('Login devuelve el usuario esperado', () => pm.expect(body.email).to.eql(pm.collectionVariables.get('email')));", "pm.collectionVariables.set('token', body.token);"] } }]
    },
    {
      "name": "03 · Crear bicicleta MongoDB",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bicicleta Ruta Daniel\",\n  \"type\": \"ELÉCTRICA\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"accessories\": [\"Casco\", \"Luces\"],\n  \"station\": \"Estación Centro\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/bikes", "host": ["{{baseUrl}}"], "path": ["api", "bikes"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Crear bicicleta responde 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.test('Se agrega Cargador por middleware Mongoose', () => pm.expect(body.accessories).to.include('Cargador'));", "pm.test('La bicicleta inicia DISPONIBLE', () => pm.expect(body.status).to.eql('DISPONIBLE'));", "pm.collectionVariables.set('bikeId', body._id);"] } }]
    },
    {
      "name": "04 · Listar bicicletas",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bikes?sort=-createdAt", "host": ["{{baseUrl}}"], "path": ["api", "bikes"], "query": [{ "key": "sort", "value": "-createdAt" }] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Listado responde 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('Listado es un arreglo', () => pm.expect(body).to.be.an('array'));", "pm.test('El listado no está vacío', () => pm.expect(body.length).to.be.greaterThan(0));", "pm.test('Incluye la bicicleta creada', () => pm.expect(body.some((bike) => bike._id === pm.collectionVariables.get('bikeId'))).to.be.true);"] } }]
    },
    {
      "name": "05 · Buscar por q",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bikes?q=Daniel&fields=name,type,station&sort=name", "host": ["{{baseUrl}}"], "path": ["api", "bikes"], "query": [{ "key": "q", "value": "Daniel" }, { "key": "fields", "value": "name,type,station" }, { "key": "sort", "value": "name" }] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Búsqueda responde 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('La búsqueda devuelve coincidencias', () => pm.expect(body.length).to.be.greaterThan(0));", "pm.test('La proyección limita campos', () => { pm.expect(body[0]).to.have.property('name'); pm.expect(body[0]).to.not.have.property('serialNumber'); });"] } }]
    },
    {
      "name": "06 · Obtener bicicleta",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bikes/{{bikeId}}", "host": ["{{baseUrl}}"], "path": ["api", "bikes", "{{bikeId}}"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Detalle responde 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('El detalle corresponde al id', () => pm.expect(body._id).to.eql(pm.collectionVariables.get('bikeId')));", "pm.test('El virtual isAvailable existe', () => pm.expect(body).to.have.property('isAvailable', true));"] } }]
    },
    {
      "name": "07 · Rechazar id inválido",
      "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bikes/no-es-objectid", "host": ["{{baseUrl}}"], "path": ["api", "bikes", "no-es-objectid"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Id inválido responde 400', () => pm.response.to.have.status(400));"] } }]
    },
    {
      "name": "08 · Crear alquiler PostgreSQL",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"bikeId\": \"{{bikeId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals", "host": ["{{baseUrl}}"], "path": ["api", "rentals"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Crear alquiler responde 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.test('El alquiler inicia ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));", "pm.test('El alquiler tiene código', () => pm.expect(body.code).to.match(/^ALQ-/));", "pm.collectionVariables.set('rentalId', body.id);"] } }]
    },
    {
      "name": "09 · Impedir doble alquiler",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"bikeId\": \"{{bikeId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/rentals", "host": ["{{baseUrl}}"], "path": ["api", "rentals"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bicicleta duplicada responde 409', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "10 · Consulta unida Rental + Bike",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/rentals/with-bikes", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "with-bikes"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta unida responde 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('La consulta devuelve filas', () => pm.expect(body.length).to.be.greaterThan(0));", "pm.test('La fila unida tiene bike', () => pm.expect(body.find((row) => row.id === pm.collectionVariables.get('rentalId')).bike).to.have.property('_id'));"] } }]
    },
    {
      "name": "11 · Devolver alquiler",
      "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/return", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "{{rentalId}}", "return"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Devolución responde 200', () => pm.response.to.have.status(200));", "pm.test('Estado es RETURNED', () => pm.expect(pm.response.json().status).to.eql('RETURNED'));", "pm.test('La devolución registra fecha', () => pm.expect(pm.response.json().returnedAt).to.exist);"] } }]
    },
    {
      "name": "12 · Crear reporte de estado 1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"rentalId\": \"{{rentalId}}\",\n  \"status\": \"BUENO\",\n  \"rating\": 5,\n  \"notes\": \"La bicicleta regresó en buen estado\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reporte responde 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.test('Copia rentalCode y bikeName', () => { pm.expect(body).to.have.property('rentalCode'); pm.expect(body).to.have.property('bikeName'); });", "pm.collectionVariables.set('reportId1', body._id);"] } }]
    },
    {
      "name": "13 · Crear reporte de estado 2",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"rentalId\": \"{{rentalId}}\",\n  \"status\": \"DAÑO_LEVE\",\n  \"rating\": 4,\n  \"notes\": \"Se observó un rasguño pequeño\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] }
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Segundo reporte responde 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('reportId2', pm.response.json()._id);"] } }]
    },
    {
      "name": "14 · Listar reportes con aggregate",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reportes responden 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('Incluye dos reportes y resumen', () => { pm.expect(body.items.length).to.be.at.least(2); pm.expect(body.summary.totalReports).to.be.at.least(2); });", "pm.test('El aggregate calcula promedio', () => pm.expect(body.summary.averageRating).to.be.a('number'));", "pm.test('Populate incluye datos de bicicleta', () => pm.expect(body.items[0].bikeId).to.have.property('name'));"] } }]
    },
    {
      "name": "15 · Borrado bloqueado mientras existe Rental",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/bikes/{{bikeId}}", "host": ["{{baseUrl}}"], "path": ["api", "bikes", "{{bikeId}}"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Borrado protegido responde 409', () => pm.response.to.have.status(409));"] } }]
    },
    {
      "name": "16 · Limpiar reporte 1",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/reports/{{reportId1}}", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId1}}"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Limpieza reporte 1 responde 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "17 · Limpiar reporte 2",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/reports/{{reportId2}}", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId2}}"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Limpieza reporte 2 responde 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "18 · Limpiar alquiler",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/rentals/{{rentalId}}", "host": ["{{baseUrl}}"], "path": ["api", "rentals", "{{rentalId}}"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Limpieza alquiler responde 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "19 · Limpiar bicicleta",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/bikes/{{bikeId}}", "host": ["{{baseUrl}}"], "path": ["api", "bikes", "{{bikeId}}"] } },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Limpieza bicicleta responde 200', () => pm.response.to.have.status(200));", "pm.test('La limpieza confirma reportes asociados', () => pm.expect(pm.response.json().deletedReports).to.be.true);"] } }]
    }
  ]
}
